# Copy this to .env and adjust values.
DB_USERNAME=app
DB_PASSWORD=app
DB_NAME=telecom_db
# DB_HOST and DB_PORT are set in docker-compose for containers (db:5432)
SECRET_KEY=change-me-please

# Optional: if you want pgAdmin container
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Optional: your app already supports this setting
RESET_LINK_VIA_UI=1
